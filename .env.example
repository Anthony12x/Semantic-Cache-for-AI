# Semantic Gateway Configuration
# Copy this file to .env and adjust values for your environment.

# Redis connection string
REDIS_URL=redis://localhost:6379

# Ollama API endpoint (use host.docker.internal when running in Docker on Windows)
OLLAMA_URL=http://host.docker.internal:11434

# Maximum cosine distance for a cache hit (lower = stricter matching)
# Run scripts/calibrate_thresholds.py to find the optimal value for your data
CACHE_THRESHOLD=0.12

# Embedding vector dimension (must match the model used by embedder.py)
# all-MiniLM-L6-v2 = 384
VECTOR_DIMENSION=384
