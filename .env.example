# Semantic Gateway Configuration
# Copy this file to .env and adjust values for your environment.

# Redis connection string
REDIS_URL=redis://localhost:6379

# Ollama API endpoint (use host.docker.internal when running in Docker on Windows)
OLLAMA_URL=http://host.docker.internal:11434

# Cosine distance threshold for cache hits (lower = stricter)
# Run scripts/calibrate_thresholds.py to find the optimal value
CACHE_THRESHOLD=0.22

# Dense embedding model
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_NAME=bge_base_en_v1_5
VECTOR_DIMENSION=768

# ColBERT reranker
COLBERT_MODEL_ID=colbert-ir/colbertv2.0
MAXSIM_THRESHOLD=12.00
